# 모든 사건과 대화는 이 게임을 위한 창작입니다. 확정 프로필은 data/heroines.json.
label ch01:
    $ chapter = "CH01 · 어쩌다 축제 준비팀"
    $ location_name = "하온대학교 · 중앙광장"
    show screen chapter_stamp
    "중앙광장에는 ‘봄 축제 준비팀 모집’이라는 종이가 바람에 펄럭이고 있었다."
    "그리고 그 아래, 종이를 붙잡는 사람보다 종이 상자에 붙잡힌 사람이 먼저 보였다."
    show darim neutral at right_slot
    darim "저기요. 괜찮으시면 이 문만 잠깐 잡아 주실래요? 상자가 생각보다 커서요."
    mc "네. 어느 쪽으로 열면 되죠?"
    darim "당기는 쪽이요. 지금은 제가 문이랑 토론에서 지고 있어서요."
    "문을 당기자 상자 위에 얹힌 마스킹 테이프가 또르르 굴렀다. 누군가 운동화 앞코로 가볍게 멈춰 세웠다."
    show sia smile at left_slot
    sia "입구에서부터 물리 엔진이 열일하네. 다림 언니, 이거 세이브하고 드셔야 하는 거 아냐?"
    darim "세이브보다 사람 한 명이 더 있으면 좋겠네요."
    sia "응 아니야~ 여기 벌써 한 명 영입했잖아. 신입 팀원, 이름이?"
    mc "[player_name]인데요. 저는 길을 물어보려고…"
    sia "오, 담당이 길 안내! 조직도가 순식간에 완성되는데?"
    "상자 뒤에서 책 한 권을 꼭 안은 학생이 고개를 내밀었다."
    show roman shy at center_slot
    roman "앗,,,! 시아 선배, 아직 오신 분한테 설명도 안 했어요."
    sia "그러네. 로만이 설명 담당. 나는 응원 담당."
    darim "응원 담당도 상자는 들 수 있어요."
    "로만은 입을 열었다가, 다시 손가락으로 책등을 문질렀다. 나는 문손잡이를 잡은 채 기다렸다."
    menu:
        "로만이 말을 마칠 때까지 기다린다.":
            $ apply_choice("c1_wait")
            roman "저희… 축제 부스를 준비하고 있어요. 길 안내도, 해 드릴 수 있고요."
            mc "둘 다 들을게요. 급한 건 아니니까요."
            roman "아… 네. 그럼, 천천히 말씀드릴게요."
            "책등을 문지르던 손이 멈췄다. 그녀의 다음 문장은 조금 길어졌다."
        "시아에게 응원 담당도 손은 두 개라고 말한다.":
            $ apply_choice("c1_joke")
            mc "응원 담당도 손은 두 개죠? 한 개만 빌려주세요."
            sia "와. 입사 첫날부터 복지 삭감이야?"
            "시아가 웃으며 상자 아래에 손을 넣었다."
            sia "좋아. 대신 너도 팀원 하면 인정."
        "다림과 상자의 무게를 나눈다.":
            $ apply_choice("c1_help")
            mc "문은 고정됐어요. 상자 반대쪽, 제가 들게요."
            darim "감사해요. 하나, 둘… 네. 무거우면 바로 말씀해 주세요."
            mc "선배도요. 혼자 들기엔 너무 큰데요."
            darim "그 말, 제가 먼저 했어야 했네요."
    hide roman
    hide sia
    hide darim
    scene bg clubroom
    with dissolve
    $ location_name = "학생회관 · 축제 준비실"
    $ play_bgm("comedy")
    "길 안내는 일단 의자 안내가 됐다. 테이블에는 자, 노트북, 카메라와 아직 주인을 못 찾은 종이컵이 놓여 있었다."
    show omu neutral at left_slot
    omu "시아야. 컵 그쪽에 두지 마라. 노트북 옆이다."
    sia "이 정도 거리면 안전하지. 고등학교 때 과학 시간에 배웠어."
    omu "니 과학 시간에 웹툰 봤잖아. 내가 옆자리였는데."
    show lumi smile at right_slot
    lumi "컵과 도면 사이의 거리는 멀수록 좋죠. 작년 축제에서 이미 실험했잖아, 시아 씨."
    sia "그때 친해진 거잖아! 관계 형성 비용이었다고 치자."
    lumi "내 셔츠가 결제했는데요."
    "로만이 물티슈를 밀어 주자 하린이는 고맙다며 컵 아래에 받침을 놓았다. 손이 익숙하게 맞았다."
    roman "동아리에서도… 하린 선배 자리는 늘 반듯해요. 책갈피까지요."
    lumi "로만 씨가 빌려 간 책은 반듯하게 안 돌아오더라. 강아지 사진 책갈피가 늘 하나씩 생겨."
    roman "그건… 책도 심심할까 봐요."
    darim "로만 씨, 오늘 교양 책에 있던 것도 그 책갈피예요? 고양이 같던데."
    roman "다림 선배 거는… 특별히 고양이로 골랐어요."
    omu "두 분 같은 수업 듣는구나. 다림 언니, 작년에 우리 같이 들은 교양 기억나요? 조별 발표."
    darim "기억하죠. 오므 씨가 사진을 맡아 줬잖아요. 역할표가 처음으로 다 채워졌던 조였어요."
    sia "자, 인맥 소개 끝났고. 이쪽은 오늘 문 열다가 채용된 [player_name]."
    mc "채용 동의는 아직 안 했습니다."
    omu "그라면 먼저 물어봐야지. 시아 니는 사람을 왜 소품처럼 데려오는데."
    sia "맞네. 미안. 우리 잠깐만 도와줄래? 오늘 회의만 들어도 돼."
    "웃는 얼굴은 그대로였지만, 질문 끝은 이번엔 올라가 있었다. 내가 거절할 자리도 남아 있었다."
    mc "오늘 회의까지요. 그다음은 일정 보고 정할게요."
    darim "좋아요. 그럼 필요한 일부터 같이 봐요."
    "부스 주제는 ‘봄을 빌려 드립니다’. 짧은 문장과 사진을 골라, 축제에서 보낼 편지를 만드는 작은 공간이었다."
    lumi "동선은 제가 볼게요. 사람이 멈추는 곳이랑 지나가는 곳은 나누는 게 좋겠네."
    sia "움직이는 안내판은 내가 그릴게. 길 잘못 들면 캐릭터가 놀리는 걸로."
    omu "처음 온 사람 놀리지 마라. 사진은 내가 찍을게. 허락 받은 사람만."
    roman "문장은… 제가 모아 볼게요. 너무 길지 않은 걸로요."
    darim "저는 일정과 물품을 정리할게요. 혼자 맡기엔 많은 일은 표시하고요."
    "노트 한 칸이 비어 있었다. 내 이름이 들어갈 만큼의 자리였다."
    menu:
        "오므와 사진 위치를 확인한다.":
            $ apply_choice("c2_photo")
            mc "사진에 얼굴이 안 나오고 싶은 사람도 고를 수 있게 하면 어때요?"
            omu "좋네. 손만 찍어도 되고, 풍경만 골라도 되고."
            "오므가 카메라를 들다가 멈췄다."
            omu "니도 괜찮으면 손 좀 빌려주라. 시험 사진. 싫으면 안 해도 된다."
            mc "괜찮아요. 이 정도 각도면 될까요?"
            omu "어. 지금 좋다. 말 잘 알아듣네."
        "하린과 부스 도면을 살펴본다.":
            $ apply_choice("c2_plan")
            mc "여기 의자 하나 더 놓을 수 있나요? 편지 쓰는 데 오래 걸릴 수도 있으니까."
            lumi "통로가 조금 좁아지는데… 잠깐. 안내판을 옮기면 되겠다."
            "하린이는 지우개를 찾다가, 내가 내민 것을 받았다. 손끝이 아주 잠깐 닿았다."
            lumi "고마워. 사람 마음에도 여백이 필요하네요. 네 덕분에 의자 하나 생겼어."
        "로만, 시아와 안내 문구를 쓴다.":
            $ apply_choice("c2_script")
            sia "‘입장하면 운명의 상대를 만날 확률 대폭 상승.’ 어때?"
            roman "근거가… 없지 않아요?"
            mc "‘여기서 잠깐 쉬어 가도 됩니다.’는 어때요?"
            roman "그 말은… 저도 들어가 보고 싶어요."
            sia "좋네. 그럼 그림은 앉을 자리 비워 두는 걸로. 내 캐릭터도 좀 쉬자."
    "테이블 건너편에서는 다림이 항목마다 작은 네모를 그렸다. 아직 빈 네모가 더 많았다."
    omu "언니, 체크리스트가 게임 퀘스트 같아요."
    darim "보상은 아직 예산에 없네요."
    sia "우리의 우정?"
    darim "그건 공동 소유라, 보상으로 또 지급하면 이중 계산이에요."
    "웃음이 지나간 뒤, 다림이 오늘 안에 끝낼 일에 동그라미를 쳤다. 생각보다 많았다."
    $ play_bgm("emotional")
    darim "가능한 만큼만 적어 주세요. 나중에 못 한다고 말하는 것보다, 지금 알려 주시는 게 좋아요."
    "나는 ‘오늘 회의까지만’이라고 말했던 것을 떠올렸다. 분위기에 휩쓸려 전부 하겠다고 적기는 쉬웠다."
    menu:
        "내 시간을 솔직하게 적고 일을 나눈다.":
            $ apply_choice("c3_honest")
            mc "저는 내일 오후 한 시간 가능해요. 물품 표를 같이 정리할 수 있어요."
            darim "한 시간이면 충분해요. 나머지는 제 일정도 다시 볼게요."
            lumi "그럼 도면 확인도 그때 맞출게. 약속은 작아도 정확한 게 좋죠."
        "말수가 줄어든 사람들의 의견을 먼저 묻는다.":
            $ apply_choice("c3_listen")
            mc "로만 씨랑 오므 씨는요? 꼭 오늘 결정 안 해도 되는 게 있을까요?"
            roman "문구는… 읽어 보고 정하면 좋겠어요. 지금 바로 고르려니까, 자꾸 비슷한 말만 떠올라서요."
            omu "나도. 사진 찍을 시간대 한 번 봐야겠다. 해 지기 전에."
            "오늘 해야 할 동그라미가 두 개 줄었다. 누구도 불평하지 않았다."
        "웃음 뒤에 조용해진 시아에게 말을 건넨다.":
            $ apply_choice("c3_sia")
            mc "시아 선배, 안내판 작업량은 괜찮아요? 혼자 다 그리는 거죠?"
            sia "…음. 사실 움직이게 하려면 좀 걸려. 아까 장난치다가 말할 타이밍 놓쳤어."
            mc "정지 그림부터 보여 주면 어때요? 그것만으로도 좋을 것 같은데요."
            sia "그 말 취소하기 없기. 중간에 강제종료하면 나 진짜 싫어해."
            "목소리는 장난스러웠다. 하지만 시아는 ‘정지 그림 먼저’라는 줄을 지우지 않았다."
    "회의가 끝날 무렵, 바닥에 종이 조각 하나가 떨어졌다. 오므가 주워 분리수거함에 넣었다."
    sia "표정 너무 무서워. 종이한테 사과해야겠다."
    omu "안 무섭거든. 나 지금 서울말로 부드럽게 말하고 있거든?"
    lumi "서울이 오늘 부산으로 이사 왔나 봐요."
    omu "하린 언니까지 왜 이래요."
    roman "앗,,,! 그럼… 전입신고 해야 하는 거 아니에요?"
    "가장 늦게 웃기 시작한 로만이, 가장 오래 웃었다."
    hide omu
    hide lumi
    scene bg sunset
    with dissolve
    $ location_name = "하온대학교 · 학생회관 앞"
    $ play_bgm("romantic")
    "복도 끝 창문에 저녁빛이 걸렸다. 함께 문을 나서자, 방금까지 낯설던 캠퍼스가 조금 다르게 보였다."
    "다들 각자의 다음 일정이 있었다. 누군가와 조금 더 걸을 수 있는 짧은 길만 남아 있었다."
    menu:
        "로만에게 책 이야기를 묻는다.":
            $ apply_choice("c4_roman")
            show roman shy at center_slot
            mc "아까 안고 있던 책, 무슨 책이에요?"
            roman "짧은 편지 모음이에요. 말보다 글이… 조금 덜 떨릴 때가 있어서요."
            mc "오늘 설명 잘 들었어요."
            if "waited_for_roman" in event_flags:
                show roman smile
                roman "기다려 주셨잖아요. 다음엔… 일부러 조금 뜸 들여도 되나요?"
                mc "그건 장난이죠?"
                roman "들켰네요. 아직 한 번도 안 했는데."
            else:
                roman "아… 다행이에요. 다음엔 좀 더 빨리 말씀드릴게요."
                mc "급하지 않아도 괜찮아요."
        "시아와 정문 쪽으로 걷는다.":
            $ apply_choice("c4_sia")
            show sia smile at center_slot
            sia "오늘 신입 팀원 평가는… 보류! 다음 회의 출석하면 알려 드립니다."
            mc "그럼 제 팀 평가도 보류예요."
            sia "오, 벌써 반격해? 마음에 드네."
            "시아는 웃다가 내 걸음에 속도를 맞췄다."
            sia "아까 남겠다고 해 준 거, 고마웠어. 이건 농담 아니고."
        "다림과 남은 물품을 옮긴다.":
            $ apply_choice("c4_darim")
            show darim neutral at center_slot
            darim "이건 제가 들 수 있어요. 아까도 도와주셨는데."
            mc "그럼 하나씩 들죠. 혼자 들 수 있는 거랑 혼자 들어야 하는 건 다르니까요."
            "다림은 잠시 나를 보더니, 작은 상자를 내 쪽으로 밀었다."
            darim "그럼 다음 회의에도 파티원 한 자리 부탁드려도 될까요?"
            mc "보상은요?"
            darim "제가 먼저 문 열어 드릴게요. 꽤 좋은 보상인데요."
        "오므에게 오늘 사진을 보여 달라고 한다.":
            $ apply_choice("c4_omu")
            show omu smile at center_slot
            omu "이거 봐라. 사람 없어도 누가 있었는지 알겠제? 컵 다섯 개에 새 컵 하나."
            mc "제 컵도 있네요."
            omu "니도 앉아 있었잖아. 안 찍혔다고 없는 게 되나."
            "사진 속 빈 의자가 낯설지 않았다."
            omu "…마음에 들면 보내줄게. 단톡방에서."
        "하린과 접힌 도면을 정리한다.":
            $ apply_choice("c4_lumi")
            show lumi smile at center_slot
            lumi "접는 선이 안 맞네. 이런 건 보통 그냥 못 넘기는데."
            mc "다시 접을까요?"
            "하린이는 내가 잡은 반대편을 보았다."
            show lumi shy
            lumi "아니. 지금은 됐어. …같이 잡고 있으니까."
            mc "네?"
            lumi "바람 불잖아. 놓치지 말라고요."
            "대답은 빨랐는데, 도면의 모서리를 맞추는 손은 조금 늦었다."
    hide roman
    hide sia
    hide darim
    hide omu
    hide lumi
    $ play_bgm("daily")
    "휴대전화가 짧게 울렸다. 시아가 만든 단톡방 이름은 ‘봄을 빌리는 사람들’이었다."
    team "시아: 새 팀원 환영. 퇴사 신청은 다음 회의에서 받습니다."
    team "오므: 와 사람을 또 붙잡노. 일정은 물어봐야지."
