  "records": [
    {
      "line": 31,
      "speaker": "narrator",
      "text": "토요일 오후."
    },
    {
      "line": 33,
      "speaker": "narrator",
      "text": "오늘은 다림 씨의 집에 가기로 했다."
    },
    {
      "line": 35,
      "speaker": "narrator",
      "text": "며칠 전부터 선배가 직접 저녁을 만들어 주겠다고 했기 때문이다."
    },
    {
      "line": 37,
      "speaker": "narrator",
      "text": "평소에도 요리를 조금씩 한다고 했지만, 나에게 직접 만들어 주는 건 이번이 처음이라고 했다."
    },
    {
      "line": 44,
      "speaker": "darim",
      "text": "오늘 약속 기억하고 계시죠?"
    },
    {
      "line": 47,
      "speaker": "mc",
      "text": "네. 오후 다섯 시까지 가면 되죠?"
    },
    {
      "line": 50,
      "speaker": "darim",
      "text": "맞아요."
    },
    {
      "line": 52,
      "speaker": "darim",
      "text": "그리고 오늘은 조금 특별한 날이에요."
    },
    {
      "line": 55,
      "speaker": "mc",
      "text": "무슨 특별한 날인데요?"
    },
    {
      "line": 58,
      "speaker": "darim",
      "text": "후후."
    },
    {
      "line": 60,
      "speaker": "darim",
      "text": "도착하시면 알려드릴게요."
    },
    {
      "line": 63,
      "speaker": "mc",
      "text": "기대해도 되나요?"
    },
    {
      "line": 66,
      "speaker": "darim",
      "text": "네."
    },
    {
      "line": 68,
      "speaker": "darim",
      "text": "조금은요."
    },
    {
      "line": 72,
      "speaker": "narrator",
      "text": "……또 무언가 준비하셨나 보다."
    },
    {
      "line": 75,
      "speaker": "mc",
      "text": "알겠어요. 이따 뵐게요."
    },
    {
      "line": 78,
      "speaker": "darim",
      "text": "네. 조심히 오세요."
    },
    {
      "line": 86,
      "speaker": "narrator",
      "text": "약속 시간에 맞춰 다림 씨의 집에 도착했다."
    },
    {
      "line": 88,
      "speaker": "narrator",
      "text": "초인종을 누르자 잠시 뒤 문이 열렸다."
    },
    {
      "line": 91,
      "speaker": "darim",
      "text": "어서 오세요."
    },
    {
      "line": 94,
      "speaker": "mc",
      "text": "안녕하세요, 선배."
    },
    {
      "line": 97,
      "speaker": "darim",
      "text": "후후. 들어오세요."
    },
    {
      "line": 101,
      "speaker": "narrator",
      "text": "평소와 크게 다르지 않은 모습이었다."
    },
    {
      "line": 103,
      "speaker": "narrator",
      "text": "그런데 주방 쪽에서 맛있는 냄새가 났다."
    },
    {
      "line": 106,
      "speaker": "mc",
      "text": "벌써 요리하고 계셨어요?"
    },
    {
      "line": 109,
      "speaker": "darim",
      "text": "네. 거의 다 준비했어요."
    },
    {
      "line": 112,
      "speaker": "mc",
      "text": "오늘은 어떤 걸 만드셨어요?"
    },
    {
      "line": 115,
      "speaker": "darim",
      "text": "그건 조금 있다가 알려드릴게요."
    },
    {
      "line": 119,
      "speaker": "narrator",
      "text": "선배는 웃으며 주방으로 향했다."
    },
    {
      "line": 121,
      "speaker": "narrator",
      "text": "나는 가방을 내려놓고 따라갔다."
    },
    {
      "line": 137,
      "speaker": "narrator",
      "text": "주방에 들어가자 다림 씨가 보였다."
    },
    {
      "line": 139,
      "speaker": "narrator",
      "text": "평소보다 조금 편안한 차림이었다."
    },
    {
      "line": 141,
      "speaker": "narrator",
      "text": "흰색 셔츠를 입고 있었고, 긴 머리는 자연스럽게 정리되어 있었다."
    },
    {
      "line": 143,
      "speaker": "narrator",
      "text": "그리고 머리 위의 귀와 뒤쪽의 풍성한 꼬리가 살짝 움직였다."
    },
    {
      "line": 146,
      "speaker": "mc",
      "text": "……."
    },
    {
      "line": 149,
      "speaker": "darim",
      "text": "왜 그렇게 보세요?"
    },
    {
      "line": 152,
      "speaker": "mc",
      "text": "아니요. 오늘은 조금 다른 느낌이어서요."
    },
    {
      "line": 155,
      "speaker": "darim",
      "text": "후후. 그런가요?"
    },
    {
      "line": 159,
      "speaker": "narrator",
      "text": "선배는 조리대 위에 놓인 재료를 정리했다."
    },
    {
      "line": 162,
      "speaker": "darim",
      "text": "오늘은 간단하게 저녁을 만들어 보려고 해요."
    },
    {
      "line": 165,
      "speaker": "mc",
      "text": "정말 기대되네요."
    },
    {
      "line": 168,
      "speaker": "darim",
      "text": "너무 기대하시면 부담스러운데요."
    },
    {
      "line": 171,
      "speaker": "mc",
      "text": "선배 요리라면 맛있을 것 같아요."
    },
    {
      "line": 174,
      "speaker": "darim",
      "text": "……."
    },
    {
      "line": 178,
      "speaker": "narrator",
      "text": "선배는 잠시 나를 바라봤다."
    },
    {
      "line": 181,
      "speaker": "darim",
      "text": "정말 말씀을 잘하시네요."
    },
    {
      "line": 184,
      "speaker": "mc",
      "text": "진심인데요."
    },
    {
      "line": 187,
      "speaker": "darim",
      "text": "후후. 알고 있어요."
    },
    {
      "line": 191,
      "speaker": "narrator",
      "text": "다림 씨는 프라이팬을 확인했다."
    },
    {
      "line": 194,
      "speaker": "darim",
      "text": "그런데 오늘은 조금 재미있는 걸 해보고 싶어요."
    },
    {
      "line": 197,
      "speaker": "mc",
      "text": "재미있는 거요?"
    },
    {
      "line": 200,
      "speaker": "darim",
      "text": "네."
    },
    {
      "line": 203,
      "speaker": "darim",
      "text": "요리도 요리지만……."
    },
    {
      "line": 207,
      "speaker": "narrator",
      "text": "선배는 나를 바라보며 웃었다."
    },
    {
      "line": 210,
      "speaker": "darim",
      "text": "오늘은 제가 조금 장난을 쳐도 괜찮을까요?"
    },
    {
      "line": 213,
      "speaker": "mc",
      "text": "장난이요?"
    },
    {
      "line": 216,
      "speaker": "darim",
      "text": "네."
    },
    {
      "line": 218,
      "speaker": "darim",
      "text": "그동안은 제가 당하는 쪽이었잖아요."
    },
    {
      "line": 222,
      "speaker": "narrator",
      "text": "……."
    },
    {
      "line": 224,
      "speaker": "narrator",
      "text": "설마."
    },
    {
      "line": 227,
      "speaker": "mc",
      "text": "무슨 장난인데요?"
    },
    {
      "line": 230,
      "speaker": "darim",
      "text": "아직 비밀이에요."
    },
    {
      "line": 234,
      "speaker": "narrator",
      "text": "선배는 아무렇지 않게 웃었다."
    },
    {
      "line": 236,
      "speaker": "narrator",
      "text": "그런데 왠지 불안하다."
    },
    {
      "line": 252,
      "speaker": "narrator",
      "text": "다림 씨는 요리를 잠시 멈추고 내 쪽으로 다가왔다."
    },
    {
      "line": 255,
      "speaker": "darim",
      "text": "저기."
    },
    {
      "line": 258,
      "speaker": "mc",
      "text": "네?"
    },
    {
      "line": 261,
      "speaker": "darim",
      "text": "잠깐 가까이 와보세요."
    },
    {
      "line": 264,
      "speaker": "mc",
      "text": "왜요?"
    },
    {
      "line": 267,
      "speaker": "darim",
      "text": "확인할 게 있어서요."
    },
    {
      "line": 271,
      "speaker": "narrator",
      "text": "나는 선배에게 조금 다가갔다."
    },
    {
      "line": 274,
      "speaker": "darim",
      "text": "……후후."
    },
    {
      "line": 277,
      "speaker": "mc",
      "text": "무슨 일이세요?"
    },
    {
      "line": 280,
      "speaker": "darim",
      "text": "그냥요."
    },
    {
      "line": 284,
      "speaker": "narrator",
      "text": "선배는 내 얼굴을 잠시 바라봤다."
    },
    {
      "line": 286,
      "speaker": "narrator",
      "text": "그러더니 자신의 셔츠 옷깃을 손으로 가볍게 잡았다."
    },
    {
      "line": 289,
      "speaker": "darim",
      "text": "있잖아요."
    },
    {
      "line": 292,
      "speaker": "mc",
      "text": "네?"
    },
    {
      "line": 295,
      "speaker": "darim",
      "text": "오늘은 제가 조금 예쁘게 보이나요?"
    },
    {
      "line": 298,
      "speaker": "mc",
      "text": "……네?"
    },
    {
      "line": 301,
      "speaker": "darim",
      "text": "후후."
    },
    {
      "line": 305,
      "speaker": "narrator",
      "text": "선배는 평소와 다르게 장난스러운 표정을 지었다."
    },
    {
      "line": 308,
      "speaker": "darim",
      "text": "왜 그렇게 놀라세요?"
    },
    {
      "line": 311,
      "speaker": "mc",
      "text": "아니요. 갑자기 물어보셔서요."
    },
    {
      "line": 314,
      "speaker": "darim",
      "text": "그럼 다시 물어볼게요."
    },
    {
      "line": 317,
      "speaker": "darim",
      "text": "오늘의 저는 어떠세요?"
    },
    {
      "line": 320,
      "speaker": "mc",
      "text": "정말 예쁘세요."
    },
    {
      "line": 323,
      "speaker": "darim",
      "text": "……."
    },
    {
      "line": 326,
      "speaker": "darim",
      "text": "그렇군요."
    },
    {
      "line": 330,
      "speaker": "narrator",
      "text": "선배는 만족한 듯 웃었다."
    },
    {
      "line": 332,
      "speaker": "narrator",
      "text": "그런데 갑자기 셔츠의 윗부분을 살짝 잡아당겼다."
    },
    {
      "line": 345,
      "speaker": "darim",
      "text": "……그런데."
    },
    {
      "line": 348,
      "speaker": "mc",
      "text": "네?"
    },
    {
      "line": 351,
      "speaker": "darim",
      "text": "조금 더 가까이 와보실래요?"
    },
    {
      "line": 355,
      "speaker": "narrator",
      "text": "……."
    },
    {
      "line": 357,
      "speaker": "narrator",
      "text": "선배가 평소와 다르다."
    },
    {
      "line": 360,
      "speaker": "mc",
      "text": "왜요?"
    },
    {
      "line": 363,
      "speaker": "darim",
      "text": "글쎄요."
    },
    {
      "line": 367,
      "speaker": "narrator",
      "text": "다림 씨는 셔츠의 단추 근처에 손을 가져갔다."
    },
    {
      "line": 370,
      "speaker": "darim",
      "text": "조금 더워서요."
    },
    {
      "line": 372,
      "speaker": "darim",
      "text": "이렇게 입고 있으니까 답답하네요."
    },
    {
      "line": 376,
      "speaker": "narrator",
      "text": "선배는 일부러 천천히 옷깃을 정리했다."
    },
    {
      "line": 378,
      "speaker": "narrator",
      "text": "그러더니 단추 하나에 손을 가져갔다."
    },
    {
      "line": 381,
      "speaker": "darim",
      "text": "……."
    },
    {
      "line": 384,
      "speaker": "darim",
      "text": "벗어도 괜찮을까요?"
    },
    {
      "line": 389,
      "speaker": "mc",
      "text": "……네?"
    },
    {
      "line": 393,
      "speaker": "narrator",
      "text": "……뭐?"
    },
    {
      "line": 396,
      "speaker": "darim",
      "text": "후후."
    },
    {
      "line": 398,
      "speaker": "darim",
      "text": "왜 그렇게 굳으셨어요?"
    },
    {
      "line": 401,
      "speaker": "mc",
      "text": "아니, 그게……."
    },
    {
      "line": 404,
      "speaker": "darim",
      "text": "제가 더워서 셔츠를 조금 편하게 입으려고 하는 건데요."
    },
    {
      "line": 408,
      "speaker": "narrator",
      "text": "선배는 옷깃을 살짝 잡은 채 나를 바라봤다."
    },
    {
      "line": 411,
      "speaker": "darim",
      "text": "혹시 다른 생각 하셨어요?"
    },
    {
      "line": 414,
      "speaker": "mc",
      "text": "……."
    },
    {
      "line": 418,
      "speaker": "narrator",
      "text": "……당했다."
    },
    {
      "line": 420,
      "speaker": "narrator",
      "text": "완전히 당했다."
    },
    {
      "line": 423,
      "speaker": "darim",
      "text": "후후후."
    },
    {
      "line": 426,
      "speaker": "darim",
      "text": "정말 귀여우시네요."
    },
    {
      "line": 429,
      "speaker": "mc",
      "text": "선배!"
    },
    {
      "line": 432,
      "speaker": "darim",
      "text": "네?"
    },
    {
      "line": 435,
      "speaker": "mc",
      "text": "놀리시는 거죠?"
    },
    {
      "line": 438,
      "speaker": "darim",
      "text": "……."
    },
    {
      "line": 441,
      "speaker": "darim",
      "text": "조금은요."
    },
    {
      "line": 445,
      "speaker": "narrator",
      "text": "선배는 웃음을 참지 못했다."
    },
    {
      "line": 448,
      "speaker": "darim",
      "text": "그동안 제가 얼마나 부끄러웠는지 아세요?"
    },
    {
      "line": 451,
      "speaker": "mc",
      "text": "……."
    },
    {
      "line": 454,
      "speaker": "darim",
      "text": "가끔은 저도 이렇게 장난치고 싶었거든요."
    },
    {
      "line": 457,
      "speaker": "mc",
      "text": "너무하신 거 아니에요?"
    },
    {
      "line": 460,
      "speaker": "darim",
      "text": "후후."
    },
    {
      "line": 462,
      "speaker": "darim",
      "text": "이번에는 제가 이겼네요."
    },
    {
      "line": 466,
      "speaker": "narrator",
      "text": "……이건 반박할 수가 없다."
    },
    {
      "line": 482,
      "speaker": "narrator",
      "text": "다림 씨는 셔츠 옷깃을 다시 정리했다."
    },
    {
      "line": 484,
      "speaker": "narrator",
      "text": "그리고 아무 일도 없었다는 듯 주방으로 돌아갔다."
    },
    {
      "line": 487,
      "speaker": "mc",
      "text": "……선배."
    },
    {
      "line": 490,
      "speaker": "darim",
      "text": "네?"
    },
    {
      "line": 493,
      "speaker": "mc",
      "text": "오늘 저를 놀리려고 준비하신 거죠?"
    },
    {
      "line": 496,
      "speaker": "darim",
      "text": "후후. 조금요."
    },
    {
      "line": 499,
      "speaker": "mc",
      "text": "언제부터 계획하셨어요?"
    },
    {
      "line": 502,
      "speaker": "darim",
      "text": "어제부터요."
    },
    {
      "line": 505,
      "speaker": "mc",
      "text": "어제부터요?"
    },
    {
      "line": 508,
      "speaker": "darim",
      "text": "네."
    },
    {
      "line": 511,
      "speaker": "darim",
      "text": "어떻게 하면 그쪽이 당황할지 생각해 봤어요."
    },
    {
      "line": 515,
      "speaker": "narrator",
      "text": "……그런 걸 진지하게 고민하셨다고?"
    },
    {
      "line": 518,
      "speaker": "mc",
      "text": "선배도 참……."
    },
    {
      "line": 521,
      "speaker": "darim",
      "text": "왜요?"
    },
    {
      "line": 524,
      "speaker": "mc",
      "text": "평소에는 그렇게 차분하시면서."
    },
    {
      "line": 527,
      "speaker": "darim",
      "text": "후후."
    },
    {
      "line": 530,
      "speaker": "darim",
      "text": "저도 가끔은 장난치고 싶거든요."
    },
    {
      "line": 534,
      "speaker": "narrator",
      "text": "선배는 프라이팬을 확인했다."
    },
    {
      "line": 537,
      "speaker": "darim",
      "text": "그런데."
    },
    {
      "line": 540,
      "speaker": "mc",
      "text": "네?"
    },
    {
      "line": 543,
      "speaker": "darim",
      "text": "아까 정말 놀라셨어요?"
    },
    {
      "line": 546,
      "speaker": "mc",
      "text": "……네."
    },
    {
      "line": 549,
      "speaker": "darim",
      "text": "얼마나 놀라셨어요?"
    },
    {
      "line": 552,
      "speaker": "mc",
      "text": "말로 설명하기 어려울 정도로요."
    },
    {
      "line": 555,
      "speaker": "darim",
      "text": "……."
    },
    {
      "line": 559,
      "speaker": "narrator",
      "text": "선배는 입가를 가볍게 가렸다."
    },
    {
      "line": 562,
      "speaker": "darim",
      "text": "후후후."
    },
    {
      "line": 564,
      "speaker": "darim",
      "text": "정말 성공했네요."
    },
    {
      "line": 567,
      "speaker": "mc",
      "text": "선배."
    },
    {
      "line": 570,
      "speaker": "darim",
      "text": "네?"
    },
    {
      "line": 573,
      "speaker": "mc",
      "text": "다음에는 저도 가만히 있지 않을 거예요."
    },
    {
      "line": 576,
      "speaker": "darim",
      "text": "……어머."
    },
    {
      "line": 580,
      "speaker": "narrator",
      "text": "선배는 잠시 눈을 크게 떴다."
    },
    {
      "line": 582,
      "speaker": "narrator",
      "text": "그러다가 웃었다."
    },
    {
      "line": 585,
      "speaker": "darim",
      "text": "기대할게요."
    },
    {
      "line": 588,
      "speaker": "darim",
      "text": "다만 그때도 제가 이길 것 같은데요?"
    },
    {
      "line": 591,
      "speaker": "mc",
      "text": "자신 있으시네요."
    },
    {
      "line": 594,
      "speaker": "darim",
      "text": "네."
    },
    {
      "line": 598,
      "speaker": "narrator",
      "text": "선배는 자신만만하게 대답했다."
    },
    {
      "line": 600,
      "speaker": "narrator",
      "text": "그 모습이 조금 얄미우면서도 귀여웠다."
    },
    {
      "line": 603,
      "speaker": "darim",
      "text": "아, 이제 저녁 먹을 준비를 해야겠네요."
    },
    {
      "line": 606,
      "speaker": "mc",
      "text": "제가 도와드릴까요?"
    },
    {
      "line": 609,
      "speaker": "darim",
      "text": "후후. 좋아요."
    },
    {
      "line": 612,
      "speaker": "darim",
      "text": "그럼 이번에는 정말 도움을 부탁드릴게요."
    },
    {
      "line": 616,
      "speaker": "narrator",
      "text": "나는 웃으며 앞치마 대신 조리 도구를 정리했다."
    },
    {
      "line": 618,
      "speaker": "narrator",
      "text": "오늘은 선배가 장난을 쳤지만."
    },
    {
      "line": 620,
      "speaker": "narrator",
      "text": "이런 평범한 시간이 좋았다."
    },
    {
      "line": 636,
      "speaker": "narrator",
      "text": "저녁 준비가 끝났다."
    },
    {
      "line": 638,
      "speaker": "narrator",
      "text": "다림 씨가 직접 만든 음식들이 식탁에 놓여 있었다."
    },
    {
      "line": 641,
      "speaker": "mc",
      "text": "정말 맛있어 보여요."
    },
    {
      "line": 644,
      "speaker": "darim",
      "text": "후후. 입맛에 맞았으면 좋겠네요."
    },
    {
      "line": 647,
      "speaker": "mc",
      "text": "선배가 직접 만드셨으니까요."
    },
    {
      "line": 650,
      "speaker": "darim",
      "text": "그렇게 말씀해 주시면 더 긴장되는데요."
    },
    {
      "line": 654,
      "speaker": "narrator",
      "text": "우리는 식사를 시작했다."
    },
    {
      "line": 657,
      "speaker": "mc",
      "text": "……정말 맛있어요."
    },
    {
      "line": 660,
      "speaker": "darim",
      "text": "정말요?"
    },
    {
      "line": 663,
      "speaker": "mc",
      "text": "네."
    },
    {
      "line": 666,
      "speaker": "darim",
      "text": "다행이에요."
    },
    {
      "line": 670,
      "speaker": "narrator",
      "text": "선배는 만족스럽게 웃었다."
    },
    {
      "line": 673,
      "speaker": "darim",
      "text": "오늘은 요리도 성공했고."
    },
    {
      "line": 676,
      "speaker": "mc",
      "text": "저를 놀리는 것도 성공하셨고요."
    },
    {
      "line": 679,
      "speaker": "darim",
      "text": "후후."
    },
    {
      "line": 682,
      "speaker": "darim",
      "text": "그건 정말 만족스러웠어요."
    },
    {
      "line": 686,
      "speaker": "narrator",
      "text": "……아직도 놀리시네."
    },
    {
      "line": 689,
      "speaker": "mc",
      "text": "다음에는 제가 선배를 놀려드릴게요."
    },
    {
      "line": 692,
      "speaker": "darim",
      "text": "어머."
    },
    {
      "line": 694,
      "speaker": "darim",
      "text": "그럼 다음에는 제가 조심해야겠네요."
    },
    {
      "line": 698,
      "speaker": "narrator",
      "text": "선배는 장난스럽게 웃었다."
    },
    {
      "line": 701,
      "speaker": "darim",
      "text": "그런데."
    },
    {
      "line": 704,
      "speaker": "mc",
      "text": "네?"
    },
    {
      "line": 707,
      "speaker": "darim",
      "text": "오늘 재미있었어요."
    },
    {
      "line": 710,
      "speaker": "darim",
      "text": "제가 먼저 장난도 치고, 그쪽이 당황하는 모습도 보고."
    },
    {
      "line": 713,
      "speaker": "mc",
      "text": "저는 조금 억울한데요."
    },
    {
      "line": 716,
      "speaker": "darim",
      "text": "후후."
    },
    {
      "line": 719,
      "speaker": "darim",
      "text": "그래도 좋아요."
    },
    {
      "line": 723,
      "speaker": "narrator",
      "text": "선배는 잠시 나를 바라봤다."
    },
    {
      "line": 726,
      "speaker": "darim",
      "text": "그쪽과 함께 있으면 이런 모습도 보여드릴 수 있어서 좋아요."
    },
    {
      "line": 729,
      "speaker": "mc",
      "text": "어떤 모습이요?"
    },
    {
      "line": 732,
      "speaker": "darim",
      "text": "조금 장난스럽고."
    },
    {
      "line": 734,
      "speaker": "darim",
      "text": "가끔은 부끄럽고."
    },
    {
      "line": 736,
      "speaker": "darim",
      "text": "평소보다 솔직한 모습이요."
    },
    {
      "line": 740,
      "speaker": "narrator",
      "text": "선배는 작게 웃었다."
    },
    {
      "line": 743,
      "speaker": "darim",
      "text": "앞으로도 이런 모습 많이 보여드릴게요."
    },
    {
      "line": 746,
      "speaker": "mc",
      "text": "기대할게요."
    },
    {
      "line": 749,
      "speaker": "darim",
      "text": "후후."
    },
    {
      "line": 751,
      "speaker": "darim",
      "text": "대신 다음에는 그쪽 차례예요."
    },
    {
      "line": 754,
      "speaker": "mc",
      "text": "네?"
    },
    {
      "line": 757,
      "speaker": "darim",
      "text": "저도 놀라게 해주세요."
    },
    {
      "line": 761,
      "speaker": "narrator",
      "text": "……."
    },
    {
      "line": 763,
      "speaker": "narrator",
      "text": "그건 조금 자신 없는데."
    },
    {
      "line": 766,
      "speaker": "mc",
      "text": "노력해 볼게요."
    },
    {
      "line": 769,
      "speaker": "darim",
      "text": "좋아요."
    },
    {
      "line": 773,
      "speaker": "narrator",
      "text": "우리는 웃었다."
    },
    {
      "line": 781,
      "speaker": "narrator",
      "text": "집으로 돌아갈 시간이 됐다."
    },
    {
      "line": 783,
      "speaker": "narrator",
      "text": "다림 씨는 현관 앞까지 나를 배웅했다."
    },
    {
      "line": 786,
      "speaker": "darim",
      "text": "오늘 와주셔서 고마워요."
    },
    {
      "line": 789,
      "speaker": "mc",
      "text": "저야말로 초대해 주셔서 감사해요."
    },
    {
      "line": 792,
      "speaker": "darim",
      "text": "후후."
    },
    {
      "line": 795,
      "speaker": "darim",
      "text": "그리고 아까 일은……."
    },
    {
      "line": 798,
      "speaker": "mc",
      "text": "네?"
    },
    {
      "line": 801,
      "speaker": "darim",
      "text": "너무 오래 기억하지는 마세요."
    },
    {
      "line": 805,
      "speaker": "narrator",
      "text": "나는 웃었다."
    },
    {
      "line": 808,
      "speaker": "mc",
      "text": "이미 기억에 남았는데요."
    },
    {
      "line": 811,
      "speaker": "darim",
      "text": "……."
    },
    {
      "line": 814,
      "speaker": "darim",
      "text": "아."
    },
    {
      "line": 817,
      "speaker": "darim",
      "text": "그렇군요."
    },
    {
      "line": 821,
      "speaker": "narrator",
      "text": "선배는 잠시 부끄러운 표정을 지었다."
    },
    {
      "line": 824,
      "speaker": "darim",
      "text": "그럼 오늘은 제가 이긴 걸로 할게요."
    },
    {
      "line": 827,
      "speaker": "mc",
      "text": "다음에는 제가 이길 거예요."
    },
    {
      "line": 830,
      "speaker": "darim",
      "text": "후후. 기대할게요."
    },
    {
      "line": 834,
      "speaker": "narrator",
      "text": "선배는 내 손을 잡았다."
    },
    {
      "line": 837,
      "speaker": "darim",
      "text": "……좋아해요."
    },
    {
      "line": 840,
      "speaker": "mc",
      "text": "저도 좋아해요, 다림 씨."
    },
    {
      "line": 843,
      "speaker": "darim",
      "text": "……."
    },
    {
      "line": 847,
      "speaker": "narrator",
      "text": "선배는 환하게 웃었다."
    },
    {
      "line": 850,
      "speaker": "darim",
      "text": "그럼 조심히 들어가세요."
    },
    {
      "line": 853,
      "speaker": "mc",
      "text": "네. 다음에 봬요."
    },
    {
      "line": 857,
      "speaker": "narrator",
      "text": "문이 닫혔다."
    },
    {
      "line": 859,
      "speaker": "narrator",
      "text": "나는 잠시 현관 앞에 서 있었다."
    },
    {
      "line": 861,
      "speaker": "narrator",
      "text": "……오늘은 완전히 당했다."
    },
    {
      "line": 863,
      "speaker": "narrator",
      "text": "그런데 이상하게 기분이 좋았다."
    },
    {
      "line": 869,
      "speaker": "narrator",
      "text": "「늘 침착했던 선배에게도」"
    },
    {
      "line": 871,
      "speaker": "narrator",
      "text": "「장난치고 싶은 날이 있었다.」"
    },
    {
      "line": 873,
      "speaker": "narrator",
      "text": "「그리고 그 장난은」"
    },
    {
      "line": 875,
      "speaker": "narrator",
      "text": "「오직 사랑하는 사람에게만 보여주는 특별한 모습이었다.」"
    }
  ],
